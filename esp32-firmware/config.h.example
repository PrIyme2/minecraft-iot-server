// 1. WLAN Zugangsdaten (Unterstuetzt mehrere Netzwerke via WiFiMulti)
#define WIFI_SSID_1         "DEIN_HEIM_WLAN"
#define WIFI_PASS_1         "DEIN_WLAN_PASSWORT"

// Optionales Zweit-Netzwerk (z. B. mobiler Handy-Hotspot fuer unterwegs)
#define WIFI_SSID_2         "DEIN_HOTSPOT_NAME"
#define WIFI_PASS_2         "DEIN_HOTSPOT_PASSWORT"

// 2. Endpunkte der REST-Bridge
// Lokale LAN-Adresse des Host-Servers (schneller Zugriff im Heimnetz)
#define LOCAL_BASE_URL      "http://192.168.0.33:5000"

// Weltweite Tailscale Funnel HTTPS-URL (fuer unterwegs / Hotspot ohne Port-Forwarding)
#define TAILSCALE_BASE_URL  "https://your-node.your-tailnet.ts.net"
