[Unit]
Description=Minecraft Performance-Monitoring & Discord-Alerting Daemon
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/prime/minecraft-monitor
ExecStart=/usr/bin/python3 -u /home/prime/minecraft-monitor/mc-perf-monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
