# ==============================================================================
# Configuration template for mc-control-service
# Copy this file to /etc/default/mc-control or export variables
# ==============================================================================

# Docker Container UUID of the Minecraft Server
MC_CONTAINER_ID="15978df8-7342-4713-8d50-3f15de6cc95d"

# Pterodactyl Wings / Agent API Token
PTERODACTYL_AGENT_TOKEN="YOUR_PTERODACTYL_AGENT_TOKEN_HERE"
AGENT_URL="http://127.0.0.1:8080"

# Minecraft RCON Connection
RCON_HOST="127.0.0.1"
RCON_PORT=25566
RCON_PASSWORD="your_secure_rcon_password"

# HTTP Control Service Port
CONTROL_PORT=5000

# Path to the backup executable
BACKUP_BIN="/usr/local/bin/minecraft-backup"
